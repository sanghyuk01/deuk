---
import '../styles/global.css';
interface Props { title?: string; description?: string; article?: boolean; }
const { title, description = '표상혁의 기술 블로그. 웹 서비스를 만들며 마주한 문제와 해결 과정을 기록합니다.', article = false } = Astro.props;
const pathname = Astro.url.pathname;
const navigation = [['HOME', '/'], ['POSTS', '/posts/'], ['PROJECT', '/projects/'], ['ABOUT', '/about/']];
const pageTitle = title ? `${title} · deuk` : 'deuk';
const canonical = new URL(pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="deuk RSS" href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={new URL('/og.svg', Astro.site)} />
    <title>{pageTitle}</title>
    <script is:inline>
      try { const preference = localStorage.getItem('deuk-theme'); document.documentElement.dataset.theme = preference || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <div class="shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="deuk 홈">deuk<span>.</span></a>
        <nav aria-label="주 메뉴">
          {navigation.map(([label, href]) => <a href={href} aria-current={(href === '/' ? pathname === '/' : pathname.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <button class="theme-toggle" aria-label="다크 모드로 전환" title="테마 전환">
          <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" /></svg>
          <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
        </button>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <span class="footer-handle">@sanghyxuk</span>
      </footer>
    </div>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const sync = () => button?.setAttribute('aria-label', document.documentElement.dataset.theme === 'dark' ? '라이트 모드로 전환' : '다크 모드로 전환');
      sync();
      button?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('deuk-theme', theme); } catch {}
        sync();
      });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
        try { if (localStorage.getItem('deuk-theme')) return; } catch {}
        document.documentElement.dataset.theme = event.matches ? 'dark' : 'light'; sync();
      });
    </script>
  </body>
</html>

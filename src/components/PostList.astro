---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
<div class="post-list">
  {posts.map(post => <article class="post-row" data-post data-tags={JSON.stringify(post.data.tags)}>
    <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
    <div class="post-content">
      {post.data.sample && <span class="sample-label">SAMPLE NOTE</span>}
      <h3><a href={`/posts/${post.id}/`}>{post.data.title}<span class="row-arrow" aria-hidden="true">↗</span></a></h3>
      <p>{post.data.description}</p>
      <div class="tags">{post.data.tags.map(tag => <a href={`/posts/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
    </div>
  </article>)}
</div>

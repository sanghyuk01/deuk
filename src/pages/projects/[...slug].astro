---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';
export async function getStaticPaths() { return (await getProjects()).map(project => ({ params: { slug: project.id }, props: { project } })); }
const { project } = Astro.props;
const { Content } = await render(project);
---
<Base title={project.data.title} description={project.data.description}>
  <header class="article-heading"><a class="back-link" href="/projects/">← 모든 프로젝트</a><span class="eyebrow project-status">{project.data.status} / {project.data.year}</span><h1>{project.data.title}</h1><p class="article-description">{project.data.description}</p><div class="tags">{project.data.stack.map(item => <span>{item}</span>)}</div>{(project.data.github || project.data.website) && <div class="project-links">{project.data.github && <a class="text-link" href={project.data.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}{project.data.website && <a class="text-link" href={project.data.website} target="_blank" rel="noopener noreferrer">사이트 방문 ↗</a>}</div>}</header>
  <div class="prose project-prose"><Content /></div>
</Base>
